# SimulStreaming Docker Configuration
# Copy this file to .env and adjust values as needed

# ==========================
# Whisper ASR Configuration
# ==========================

# Language code (fr=French, en=English, de=German, es=Spanish, etc. or 'auto')
WHISPER_LANGUAGE=fr

# Task: 'transcribe' or 'translate' (translate = speech to English text)
WHISPER_TASK=transcribe

# Minimum chunk size in seconds (time between processing updates)
WHISPER_MIN_CHUNK_SIZE=1.2

# Frame threshold for AlignAtt policy (lower = more aggressive, higher = more conservative)
# One frame = 0.02 seconds for large-v3 model
WHISPER_FRAME_THRESHOLD=25

# Number of beams for beam search (1 = greedy decoder, faster)
WHISPER_BEAMS=1

# ==========================
# Translation Configuration
# ==========================

# Target language for EuroLLM translation (fr, de, es, etc.)
TRANSLATION_LANGUAGE=fr

# Minimum chunk size for translation updates
TRANSLATION_MIN_CHUNK_SIZE=1

# Maximum context length in tokens
TRANSLATION_MAX_CONTEXT_LENGTH=300

# Buffer trimming strategy: 'sentences' or 'segments'
TRANSLATION_BUFFER_TRIMMING=sentences
